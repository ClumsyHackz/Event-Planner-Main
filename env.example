# Optional for local JSON development. If omitted, a development-only JWT secret is used.
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_at_least_12_chars
PORT=3000

# For later MongoDB Atlas migration, configure MONGODB_URI after switching the storage adapter.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
